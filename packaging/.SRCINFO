pkgbase = linuprint
	pkgdesc = Printer and scanner setup wizard for Arch Linux
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/TheGreatAzizi/LinuPrint
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = pkgconf
	makedepends = git
	depends = glibc
	depends = gcc-libs
	depends = glib2
	depends = gtk4
	depends = hicolor-icon-theme
	depends = cups
	depends = avahi
	depends = sane
	depends = polkit
	depends = xdg-utils
	optdepends = cups-filters: filters for some USB printers
	optdepends = nss-mdns: resolve .local mDNS printer names
	optdepends = sane-airscan: network eSCL and AirScan scanners
	optdepends = ipp-usb: driverless IPP printing over USB
	optdepends = hplip: HP printing and scanning
	optdepends = epson-inkjet-printer-escpr: Epson ESC/P-R printers
	optdepends = brlaser: Brother laser printers
	optdepends = gutenprint: generic printer drivers
	source = git+https://github.com/TheGreatAzizi/LinuPrint.git#tag=v0.2.0
	sha256sums = SKIP

pkgname = linuprint
